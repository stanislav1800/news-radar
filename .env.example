# Пример настроек. Скопируйте в .env и поменяйте значения: cp .env.example .env
# Все настройки и значения по умолчанию: src/sito/config.py

# База данных (порт — как в compose.yaml или compose.override.yaml)
DATABASE_URL=postgresql+asyncpg://postgres:pass@127.0.0.1:5432/sito

# Ключ: подписывает cookie сессий веба и шифрует учётные данные подключений (Telegram).
# Обязателен. Не меняйте после того, как добавили подключения: их придётся вводить заново.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SITO_SECRET_KEY=

# Веб
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# Включить, если приложение открыто через HTTPS-прокси:
# SESSION_COOKIE_SECURE=true
# Адреса прокси, которым доверять X-Forwarded-For и X-Forwarded-Proto:
# FORWARDED_ALLOW_IPS=127.0.0.1

# Логи: text для разработки, json для Docker и сборщиков логов
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Метрики Prometheus: порт внутри процесса. В compose уже задан (9100), здесь — для запуска из исходников
# METRICS_PORT=9100
# Пароль Grafana (docker compose --profile monitoring up -d), вход admin / этот пароль
# GRAFANA_PASSWORD=

# Поиск по смыслу: веб загружает модель эмбеддингов (около 1 ГБ памяти). false — поиск только по словам
# SEARCH_BY_MEANING=true

# Пароль базы для docker compose (сервис db). Задайте свой до первого запуска:
# база создаётся с ним и потом его не меняют
# POSTGRES_PASSWORD=pass

# LLM (необязательно): пересказ сюжета по кнопке. Любой сервис с API в формате OpenAI
# (routerai.ru, OpenRouter, DeepSeek, Ollama). Без этих трёх строк кнопок LLM нет.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_DAILY_TOKENS=3000000
