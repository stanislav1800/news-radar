// Alloy: читает логи контейнеров Сито через Docker и отправляет в Loki.
// Только этот compose-проект (на машине могут быть и чужие контейнеры) и без самого мониторинга.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "sito" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("SITO_PROJECT")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "prometheus|grafana|loki|alloy"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "sito" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.sito.output
  forward_to = [loki.process.sito.receiver]
}

// Веб и worker пишут JSON (src/sito/log.py): уровень — метка (их мало, по ним фильтр быстрый),
// время — из записи. Остальные поля (logger, source_id, error…) остаются в строке: | json в запросе.
// Строки не-JSON (база, бэкап) проходят как есть, с level="".
loki.process "sito" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = { level = "level", time = "time" }
  }
  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = { level = "" }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
